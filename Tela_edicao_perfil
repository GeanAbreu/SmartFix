  --chart-2: oklch(0.6708 0.1561 50.25);
  --chart-3: oklch(0.45 0.08 253.12);
  --chart-4: oklch(0.828 0.189 84.429);
  --chart-5: oklch(0.398 0.07 227.392);
  --sidebar: oklch(0.99 0.005 250);
  --sidebar-foreground: oklch(0.23 0.06 258);
