/* ====================================================================
   SmartFix — Rastreio da O.S. · estilos
   Paleta: azul (confiança) + laranja (ação/energia)
   ==================================================================== */

:root {
  --radius: 0.75rem;

  --background: #f9fafb;
  --foreground: #1e293b;
  --card: #ffffff;
  --card-foreground: #1e293b;

  --primary: #0F2A48;        /* azul profundo */
  --primary-foreground: #ffffff;

  --brand: #DF742C;         /* laranja de ação */
  --brand-foreground: #ffffff;
  --brand-soft: #FBE5D4;

  --muted: #f1f5f9;
  --muted-foreground: #64748b;
  --border: #e2e8f0;
  --success: #16a34a;
  --destructive: #dc2626;

  --shadow-card: 0 1px 2px rgba(15, 42, 72, 0.06), 0 8px 24px -8px rgba(15, 42, 72, 0.12);
  --shadow-brand: 0 6px 20px -6px rgba(223, 116, 44, 0.45);

  --gradient-hero: linear-gradient(135deg, #081A30 0%, #0F2A48 60%, #1A4470 100%);
}

* { box-sizing: border-box; margin: 0; padding: 0; }

html { -webkit-text-size-adjust: 100%; }

body {
  font-family: "Inter", system-ui, -apple-system, sans-serif;
  background: var(--background);
  color: var(--foreground);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

/* ---------- Loading */
.loading {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--background);
}
.spinner {
  width: 32px;
  height: 32px;
  border: 3px solid var(--border);
  border-top-color: var(--brand);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* ---------- Header */
.hero {
  background: var(--gradient-hero);
  color: #ffffff;
  padding: 1.25rem 1rem 2.5rem;
}
.hero-inner { max-width: 48rem; margin: 0 auto; }

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
}
.brand {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-weight: 700;
  font-size: 1.125rem;
  letter-spacing: -0.01em;
}
.brand-badge {
  width: 2.25rem;
  height: 2.25rem;
  display: grid;
  place-items: center;
  border-radius: 0.75rem;
  background: var(--brand);
  box-shadow: var(--shadow-brand);
}
.brand-badge svg { width: 1.25rem; height: 1.25rem; color: #fff; }
.brand-text strong { color: var(--brand); }

.live-chip {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background: rgba(255, 255, 255, 0.1);
  padding: 0.375rem 0.75rem;
  border-radius: 9999px;
  font-size: 0.75rem;
  font-weight: 500;
  backdrop-filter: blur(8px);
}
.live-dot {
  width: 0.5rem;
  height: 0.5rem;
  border-radius: 50%;
  background: var(--brand);
  animation: pulse 1.5s ease-in-out infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(0.8); }
}
.live-chip svg { width: 0.875rem; height: 0.875rem; }

.hero-info { margin-top: 1.75rem; }
.hero-info .label { font-size: 0.875rem; opacity: 0.7; }
.hero-info h1 {
  font-size: 1.5rem;
  font-weight: 800;
  margin-top: 0.25rem;
  letter-spacing: -0.02em;
}
.hero-info h1 .code { color: var(--brand); }
.hero-info .device {
  margin-top: 0.5rem;
  font-size: 0.875rem;
  opacity: 0.85;
}
@media (min-width: 640px) {
  .hero-info h1 { font-size: 2.25rem; }
  .hero-info .device { font-size: 1rem; }
}

.progress-block { margin-top: 1.5rem; }
.progress-row {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  justify-content: space-between;
  gap: 0.5rem;
  font-size: 0.875rem;
}
.progress-row .pct { font-weight: 600; }
.progress-row .forecast { opacity: 0.7; }
.progress-track {
  margin-top: 0.5rem;
  height: 0.625rem;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 9999px;
  overflow: hidden;
}
.progress-bar {
  height: 100%;
  background: var(--brand);
  border-radius: 9999px;
  transition: width 0.7s ease;
}

/* ---------- Main */
main {
  max-width: 48rem;
  margin: 0 auto;
  padding: 0 1rem 4rem;
}

.card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 1rem;
  box-shadow: var(--shadow-card);
  padding: 1.25rem;
}

.status-card { margin-top: -1.5rem; }
.status-card .row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 1rem;
}
.status-icon {
  width: 3.5rem;
  height: 3.5rem;
  display: grid;
  place-items: center;
  border-radius: 1rem;
  background: var(--brand);
  box-shadow: var(--shadow-brand);
  flex-shrink: 0;
}
.status-icon svg { width: 1.75rem; height: 1.75rem; color: #fff; }
.status-card .text { flex: 1; min-width: 0; }
.status-card .kicker {
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--muted-foreground);
}
.status-card .title {
  font-size: 1.25rem;
  font-weight: 700;
  margin-top: 0.125rem;
}
.status-card .detail {
  font-size: 0.875rem;
  color: var(--muted-foreground);
  margin-top: 0.125rem;
}
.chip-running {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  background: var(--brand-soft);
  color: var(--brand);
  padding: 0.375rem 0.75rem;
  border-radius: 9999px;
  font-size: 0.75rem;
  font-weight: 600;
}
.chip-running svg { width: 0.875rem; height: 0.875rem; animation: spin 0.8s linear infinite; }

/* ---------- Quote card */
.quote-card {
  margin-top: 1.25rem;
  border: 2px solid rgba(223, 116, 44, 0.5);
}
.quote-head {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}
.quote-head svg { width: 1.25rem; height: 1.25rem; color: var(--brand); }
.quote-head h2 { font-size: 1rem; font-weight: 700; }
.quote-list { margin-top: 1rem; font-size: 0.875rem; }
.quote-list .line {
  display: flex;
  justify-content: space-between;
  padding: 0.25rem 0;
}
.quote-list .line.total {
  border-top: 1px solid var(--border);
  padding-top: 0.5rem;
  margin-top: 0.25rem;
  font-size: 1rem;
}
.quote-list .total .val { font-weight: 700; color: var(--brand); }
.quote-list .val { font-weight: 500; }
.quote-list dt { color: var(--muted-foreground); }
.quote-hint {
  margin-top: 0.75rem;
  font-size: 0.75rem;
  color: var(--muted-foreground);
}
.btn-row {
  margin-top: 1rem;
  display: grid;
  gap: 0.75rem;
}
@media (min-width: 640px) { .btn-row { grid-template-columns: 1fr 1fr; } }

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  border: none;
  cursor: pointer;
  font-family: inherit;
  font-weight: 600;
  border-radius: 0.75rem;
  padding: 0.75rem 1.25rem;
  transition: transform 0.1s ease, background 0.2s ease;
}
.btn:active { transform: scale(0.99); }
.btn svg { width: 1.25rem; height: 1.25rem; }
.btn-brand {
  background: var(--brand);
  color: #fff;
  box-shadow: var(--shadow-brand);
}
.btn-brand:hover { transform: scale(1.02); }
.btn-ghost {
  background: transparent;
  border: 2px solid var(--border);
  color: var(--foreground);
}
.btn-ghost:hover { background: var(--muted); }
.btn-primary {
  background: var(--primary);
  color: #fff;
}
.btn-sm { padding: 0.625rem 1rem; font-size: 0.875rem; }

/* ---------- Approved / Refused banners */
.banner {
  margin-top: 1.25rem;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.75rem;
}
.banner svg { width: 1.5rem; height: 1.5rem; flex-shrink: 0; }
.banner.ok svg { color: var(--success); }
.banner.no svg { color: var(--destructive); }
.banner p { flex: 1; font-size: 0.875rem; }

/* ---------- Logistics */
.logistics { margin-top: 1.25rem; }
.logistics .head {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}
.logistics .head svg { width: 1.25rem; height: 1.25rem; color: var(--primary); }
.logistics .head h2 { font-size: 1rem; font-weight: 700; }
.logistics .grid {
  margin-top: 1rem;
  display: grid;
  gap: 1rem;
}
@media (min-width: 640px) { .logistics .grid { grid-template-columns: 1fr 1fr; } }
.logistics .box {
  background: var(--muted);
  border-radius: 0.75rem;
  padding: 1rem;
}
.logistics .box .kicker {
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--muted-foreground);
}
.logistics .box .place {
  margin-top: 0.25rem;
  font-size: 0.875rem;
  display: flex;
  align-items: flex-start;
  gap: 0.375rem;
}
.logistics .box svg { width: 1rem; height: 1rem; margin-top: 0.125rem; flex-shrink: 0; }
.logistics .box.pickup svg { color: var(--primary); }
.logistics .box.delivery svg { color: var(--brand); }

/* ---------- Timeline */
.timeline { margin-top: 2rem; }
.timeline h2 { font-size: 1.125rem; font-weight: 700; }
.timeline .sub { font-size: 0.875rem; color: var(--muted-foreground); }
.tl-list { list-style: none; margin-top: 1.5rem; }
.tl-item { position: relative; display: flex; gap: 1rem; }
.tl-item:not(:last-child)::before {
  content: "";
  position: absolute;
  left: 1.375rem;
  top: 2.75rem;
  height: calc(100% - 2rem);
  width: 2px;
  background: var(--border);
  border-radius: 9999px;
}
.tl-item.done:not(:last-child)::before { background: var(--primary); }
.tl-dot {
  position: relative;
  z-index: 1;
  width: 2.75rem;
  height: 2.75rem;
  flex-shrink: 0;
  display: grid;
  place-items: center;
  border-radius: 50%;
  border: 2px solid var(--border);
  background: var(--card);
  color: var(--muted-foreground);
}
.tl-item.done .tl-dot {
  border-color: var(--primary);
  background: var(--primary);
  color: #fff;
}
.tl-item.current .tl-dot {
  border-color: var(--brand);
  background: var(--brand);
  color: #fff;
  box-shadow: var(--shadow-brand);
  animation: pulse 1.5s ease-in-out infinite;
}
.tl-dot svg { width: 1.25rem; height: 1.25rem; }
.tl-card {
  margin-bottom: 1.5rem;
  flex: 1;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 0.75rem;
  padding: 1rem;
}
.tl-item.current .tl-card { border-color: rgba(223, 116, 44, 0.4); box-shadow: var(--shadow-card); }
.tl-card .top {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: space-between;
  gap: 0.5rem;
}
.tl-card .name { font-weight: 600; }
.tl-item.pending .tl-card .name { color: var(--muted-foreground); }
.tl-card .at {
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--muted-foreground);
}
.tl-card .desc {
  margin-top: 0.25rem;
  font-size: 0.875rem;
  color: var(--muted-foreground);
}

/* ---------- Partner + contact */
.partner-row {
  margin-top: 1rem;
  display: grid;
  gap: 1rem;
}
@media (min-width: 640px) { .partner-row { grid-template-columns: 1fr 1fr; } }
.partner .kicker {
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--muted-foreground);
}
.partner .info {
  margin-top: 0.75rem;
  display: flex;
  align-items: center;
  gap: 0.75rem;
}
.partner .avatar {
  width: 2.75rem;
  height: 2.75rem;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  font-weight: 700;
  font-size: 0.875rem;
}
.partner .name {
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 0.25rem;
}
.partner .name svg { width: 1rem; height: 1rem; color: var(--primary); }
.partner .meta {
  font-size: 0.75rem;
  color: var(--muted-foreground);
  display: flex;
  align-items: center;
  gap: 0.25rem;
}
.partner .meta svg { width: 0.875rem; height: 0.875rem; color: var(--brand); }
.btn-contact {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  background: var(--brand);
  color: #fff;
  border: none;
  border-radius: 1rem;
  padding: 1.25rem;
  font-weight: 600;
  font-family: inherit;
  cursor: pointer;
  box-shadow: var(--shadow-brand);
}
.btn-contact:hover { transform: scale(1.02); }
.btn-contact svg { width: 1.25rem; height: 1.25rem; }

/* ---------- QR / link */
.share { margin-top: 1rem; }
.share h2 { font-size: 1rem; font-weight: 700; }
.share .sub { font-size: 0.875rem; color: var(--muted-foreground); margin-top: 0.25rem; }
.share .body {
  margin-top: 1rem;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 1rem;
}
