/* ----------------------------------------------------------------
   ESTADO
   ---------------------------------------------------------------- */
let order = null;
let ratingValue = 0;

/* ----------------------------------------------------------------
   UTILITÁRIOS
   ---------------------------------------------------------------- */
const brl = (v) =>
  Number(v).toLocaleString("pt-BR", { style: "currency", currency: "BRL" });

const esc = (s) =>
  String(s ?? "").replace(/[&<>"']/g, (c) =>
    ({ "&": "&", "<": "<", ">": ">", '"': """, "'": "&#39;" }[c])
  );

function toast(message, type = "default", desc = "") {
  const wrap = document.getElementById("toasts");
  const el = document.createElement("div");
  el.className = `toast ${type}`;
  el.innerHTML = `<div class="t-title">${esc(message)}</div>${desc ? `<div class="t-desc">${esc(desc)}</div>` : ""}`;
  wrap.appendChild(el);
  setTimeout(() => {
    el.style.opacity = "0";
    setTimeout(() => el.remove(), 300);
  }, 3500);
}

/* ----------------------------------------------------------------
   RELÓGIO (tempo real)
   ---------------------------------------------------------------- */
function startClock() {
  const el = document.getElementById("clock");
  const tick = () => {
    const now = new Date();
    el.textContent = now.toLocaleTimeString("pt-BR", {
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
    });
  };
  tick();
  setInterval(tick, 1000);
}

/* ----------------------------------------------------------------
   BUSCA A O.S. NO BANCO + ASSINA REALTIME (RNF03)
   ---------------------------------------------------------------- */
async function loadOrder() {
  const { data, error } = await supabase
    .from("service_orders")
    .select("*")
    .eq("code", OS_CODE)
    .single();

  if (error) {
    toast("Não foi possível carregar a O.S.", "error");
    document.getElementById("app").innerHTML =
      '<div class="loading"><p style="color:#dc2626">Erro ao carregar a Ordem de Serviço.</p></div>';
    return;
  }

  order = data;
  render();

  /* Assina atualizações em tempo real */
  supabase
    .channel(`service-order-${OS_CODE}`)
    .on(
      "postgres_changes",
      { event: "UPDATE", schema: "public", table: "service_orders" },
      (payload) => {
        const row = payload.new;
        if (row.code === OS_CODE) {
          order = row;
          render();
        }
      }
    )
    .subscribe();
}

/* ----------------------------------------------------------------
   AÇÕES — aprovar / recusar orçamento (RF14)
   ---------------------------------------------------------------- */
async function approveQuote() {
  if (!order) return;
  const { error } = await supabase
    .from("service_orders")
    .update({
      quote_decision: "approved",
      current_step: 3,
      updated_at: new Date().toISOString(),
    })
    .eq("id", order.id);

  if (error) {
    toast("Não foi possível registrar a aprovação", "error");
    return;
  }
  /* Atualização otimista — o realtime confirma em seguida */
  order.quote_decision = "approved";
  order.current_step = 3;
  render();
  toast("Orçamento aprovado", "success", "A assistência já foi notificada e iniciará o reparo.");
}

async function refuseQuote() {
  if (!order) return;
  const { error } = await supabase
    .from("service_orders")
    .update({
      quote_decision: "refused",
      updated_at: new Date().toISOString(),
    })
    .eq("id", order.id);

  if (error) {
    toast("Não foi possível registrar a recusa", "error");
    return;
  }
  order.quote_decision = "refused";
  render();
  toast("Orçamento recusado", "default", "Seu aparelho será devolvido sem custo de reparo.");
}

/* ----------------------------------------------------------------
   AVALIAÇÃO (RF17) — só após concluir
   ---------------------------------------------------------------- */
function setRating(n) {
  ratingValue = n;
  render();
}
async function submitRating() {
  if (ratingValue === 0) {
    toast("Selecione uma nota de 1 a 5 estrelas", "error");
    return;
  }
  const { error } = await supabase
    .from("service_orders")
    .update({
      rating: ratingValue,
      rated_at: new Date().toISOString(),
      updated_at: new Date().toISOString(),
    })
    .eq("id", order.id);
  if (error) {
    toast("Não foi possível salvar a avaliação", "error");
    return;
  }
  order.rating = ratingValue;
  render();
  toast("Obrigado pela avaliação!", "success", "Seu feedback ajuda outros clientes.");
}

/* ----------------------------------------------------------------
   COPIAR LINK (RF13)
   ---------------------------------------------------------------- */
async function copyLink() {
  const url = `${window.location.origin}${window.location.pathname}?os=${OS_CODE}`;
  try {
    await navigator.clipboard.writeText(url);
    toast("Link de rastreio copiado", "success");
  } catch {
    toast("Não foi possível copiar o link", "error");
  }
}

/* ----------------------------------------------------------------
   RENDER
   ---------------------------------------------------------------- */
function render() {
  if (!order) return;
  const app = document.getElementById("app");

  const currentIndex = order.current_step ?? 0;
  const quoteDecision = order.quote_decision ?? "pending";
  const total =
    Number(order.quote_labor) + Number(order.quote_parts) + Number(order.quote_logistics);
  const progress = Math.round(((currentIndex + 0.5) / STEPS.length) * 100);
  const current = STEPS[currentIndex] ?? STEPS[0];

  const clock = new Date().toLocaleTimeString("pt-BR", {
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
  });

  /* Status de cada etapa */
  const stepStatus = (i) =>
    i < currentIndex ? "done" : i === currentIndex ? "current" : "pending";

  /* Timeline HTML */
  const timelineHTML = STEPS.map((step, i) => {
    const status = stepStatus(i);
    const dotIcon =
      status === "done"
        ? ICONS.checkCircle
        : status === "current"
          ? ICONS[step.icon]
          : ICONS.circleDashed;
    const at =
      step.at ?? (status === "current" ? "Agora" : status === "pending" ? "Aguardando" : "");
    const desc = status === "pending" ? step.description : step.detail;
    return `
      <li class="tl-item ${status}">
        <span class="tl-dot">${dotIcon}</span>
        <div class="tl-card">
          <div class="top">
            <p class="name">${esc(step.label)}</p>
            <span class="at">${esc(at)}</span>
          </div>
          <p class="desc">${esc(desc)}</p>
        </div>
      </li>`;
  }).join("");

  /* Card de orçamento (RF14) */
  let quoteHTML = "";
  if (quoteDecision === "pending" && currentIndex === 2) {
    quoteHTML = `
      <section class="card quote-card">
        <div class="quote-head">
          ${ICONS.clipboard}
          <h2>Orçamento aguardando sua aprovação</h2>
        </div>
        <dl class="quote-list">
          <div class="line"><dt>Mão de obra</dt><dd class="val">${brl(order.quote_labor)}</dd></div>
          <div class="line"><dt>${esc(order.quote_parts_label ?? "Peças")}</dt><dd class="val">${brl(order.quote_parts)}</dd></div>
          <div class="line"><dt>Logística (coleta + entrega)</dt><dd class="val">${brl(order.quote_logistics)}</dd></div>
          <div class="line total"><dt>Total</dt><dd class="val">${brl(total)}</dd></div>
        </dl>
        <p class="quote-hint">Prazo: 2 dias úteis após a aprovação · Garantia de 3 meses · Pagamento via PIX ou cartão somente após a aprovação.</p>
        <div class="btn-row">
          <button class="btn btn-brand" onclick="approveQuote()">${ICONS.checkCircle} Aprovar orçamento</button>
          <button class="btn btn-ghost" onclick="refuseQuote()">${ICONS.xCircle} Recusar</button>
        </div>
      </section>`;
  } else if (quoteDecision === "approved") {
    quoteHTML = `
      <section class="card banner ok">
        ${ICONS.badge}
        <p><strong>Orçamento aprovado</strong> — ${brl(total)}. Finalize o pagamento para liberar a entrega.</p>
        <button class="btn btn-primary btn-sm">${ICONS.creditCard} Pagar com PIX ou cartão</button>
      </section>`;
  } else if (quoteDecision === "refused") {
    quoteHTML = `
      <section class="card banner no">
        ${ICONS.xCircle}
        <p><strong>Orçamento recusado.</strong> A devolução do aparelho será agendada sem custo de reparo.</p>
      </section>`;
  }

  /* Avaliação (RF17) */
  let ratingHTML = "";
  if (currentIndex >= STEPS.length - 1) {
    const stars = Array.from({ length: 5 }, (_, i) => {
      const filled = i < (ratingValue || order.rating || 0);
      return `<button onclick="setRating(${i + 1})" aria-label="${i + 1} estrelas">
        <span style="color:${filled ? "var(--brand)" : "var(--border)"}">${ICONS.star}</span>
      </button>`;
    }).join("");
    ratingHTML = `
      <section class="card rating">
        <p class="head">Avaliação do serviço</p>
        <p class="sub">Dê uma nota de 1 a 5 estrelas e deixe um comentário sobre a assistência técnica.</p>
        <div class="stars active">${stars}</div>
        <textarea placeholder="Deixe um comentário (opcional)"></textarea>
        <button class="btn btn-brand btn-sm" onclick="submitRating()">Enviar avaliação</button>
      </section>`;
  } else {
    ratingHTML = `
      <section class="card rating">
        <p class="head">Avaliação do serviço</p>
        <p class="sub">Disponível quando a O.S. estiver <strong>Concluída</strong>. Você poderá dar uma nota de 1 a 5 estrelas e deixar um comentário.</p>
        <div class="stars">${Array.from({ length: 5 }, () => ICONS.star).join("")}</div>
      </section>`;
  }

  app.innerHTML = `
    <header class="hero">
      <div class="hero-inner">
        <div class="topbar">
          <div class="brand">
            <span class="brand-badge">${ICONS.wrench}</span>
            <span class="brand-text">Smart<strong>Fix</strong></span>
          </div>
          <div class="live-chip">
            <span class="live-dot"></span>
            ${ICONS.radio}
            Tempo real · <span id="clock">${clock}</span>
          </div>
        </div>

        <div class="hero-info">
          <p class="label">Ordem de Serviço</p>
          <h1>O.S. <span class="code">${esc(order.code)}</span></h1>
          <p class="device">${esc(order.device)} · ${esc(order.issue)}</p>
        </div>

        <div class="progress-block">
          <div class="progress-row">
            <span class="pct">${progress}% concluído</span>
            <span class="forecast">Previsão de entrega: ${esc(order.delivery_forecast ?? "a definir")}</span>
          </div>
          <div class="progress-track">
            <div class="progress-bar" style="width:${progress}%"></div>
          </div>
        </div>
      </div>
    </header>

    <main>
      <section class="card status-card">
        <div class="row">
          <span class="status-icon">${ICONS[current.icon]}</span>
          <div class="text">
            <p class="kicker">Status atual da O.S.</p>
            <p class="title">${esc(current.label)}</p>
            <p class="detail">${esc(current.detail)}</p>
          </div>
          <span class="chip-running">${ICONS.loader} Em andamento</span>
        </div>
      </section>

      ${quoteHTML}

      <section class="card logistics">
        <div class="head">${ICONS.bike}<h2>Logística</h2></div>
        <div class="grid">
          <div class="box pickup">
            <p class="kicker">Coleta realizada</p>
            <p class="place">${ICONS.mapPin} Rua das Palmeiras, 240 — Centro · 01/09 às 09:12</p>
          </div>
          <div class="box delivery">
            <p class="kicker">Entrega prevista</p>
            <p class="place">${ICONS.mapPin} Mesmo endereço · 04/09 entre 14h e 18h</p>
          </div>
        </div>
      </section>

      <section class="timeline">
        <h2>Linha do tempo da O.S.</h2>
        <p class="sub">Atualizada automaticamente sempre que a assistência técnica muda o status.</p>
        <ol class="tl-list">${timelineHTML}</ol>
      </section>

      <section class="partner-row">
        <div class="card partner">
          <p class="kicker">Assistência credenciada</p>
          <div class="info">
            <span class="avatar">SC</span>
            <div>
              <p class="name">SmartCell Assistência ${ICONS.badge}</p>
              <p class="meta">${ICONS.star} 4,9 · 1.240 serviços · Técnico: Rafael Souza</p>
            </div>
          </div>
        </div>
        <button class="btn-contact">${ICONS.message} Falar com a assistência</button>
      </section>

      <section class="card share">
        <h2>Acompanhe de qualquer lugar</h2>
        <p class="sub">Escaneie o QR Code ou use o link abaixo para abrir esta página sem login.</p>
        <div class="body">
          <div class="qr-box" id="qrcode"></div>
          <div class="url-box">
            <p class="url-text" id="url-text"></p>
            <button class="btn-copy" onclick="copyLink()">${ICONS.copy} Copiar link de rastreio</button>
          </div>
        </div>
      </section>

      ${ratingHTML}

      <p class="footer-note">SmartFix · Dados protegidos conforme a LGPD — visíveis apenas às partes envolvidas nesta Ordem de Serviço.</p>
    </main>
  `;

  startClock();

  /* Gera o QR Code (RF13) */
  const url = `${window.location.origin}${window.location.pathname}?os=${OS_CODE}`;
  const qrEl = document.getElementById("qrcode");
  if (qrEl) {
    qrEl.innerHTML = "";
    new QRCode(qrEl, { text: url, width: 104, height: 104, correctLevel: QRCode.CorrectLevel.M });
  }
  const urlText = document.getElementById("url-text");
  if (urlText) urlText.textContent = url;
}

