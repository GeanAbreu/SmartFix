  return (
    <header className="sticky top-0 z-30 border-b bg-brand-deep">
      <div className="mx-auto flex h-16 max-w-[1600px] items-center px-4 sm:px-6">
        <Button variant="ghost" size="icon" className="mr-2 lg:hidden" aria-label="Abrir menu">
          <Menu />
        </Button>
        <div className="flex items-center gap-2.5">
          <div className="flex size-9 items-center justify-center rounded-md bg-brand-orange font-bold text-brand-deep">S</div>
          <span className="font-display text-xl font-bold">Smart<span className="text-brand-orange">Fix</span></span>
          <span className="hidden border-l pl-3 text-xs text-muted-foreground sm:inline">PARCEIROS</span>
        </div>
        <div className="ml-auto flex items-center gap-4">
          <span className="hidden items-center gap-2 text-xs md:flex">
            <MapPin className="size-4 text-brand-orange" /> Florianópolis, SC
          </span>
          <Button variant="ghost" size="icon" className="relative" aria-label="Notificações">
