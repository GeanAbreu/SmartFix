}

function Metric({ icon: Icon, label, value, note, accent }: {
  icon: typeof MapPin; label: string; value: string; note: string; accent?: boolean;
}) {
  return (
    <article className="brand-shadow flex min-h-28 items-center gap-4 rounded-md border bg-card p-4">
      <div className={cn("flex size-10 items-center justify-center rounded-md bg-muted", accent && "bg-brand-orange-soft text-brand-orange")}>
        <Icon className="size-5" />
      </div>
      <div>
        <p className="text-xs font-semibold text-muted-foreground">{label}</p>
        <p className="mt-1 text-xl font-bold sm:text-2xl">{value}</p>
        <p className="text-[11px] text-muted-foreground">{note}</p>
      </div>
    </article>
  );
}

function RequestCard({ request, onOpen }: { request: ServiceRequest; onOpen: () => void }) {
  const Icon = deviceIcon(request.device_type);
  return (
    <article className={cn("card-rise overflow-hidden rounded-md border bg-card", request.priority === "urgent" && "border-l-4 border-l-brand-orange")}>
      <div className="flex items-center justify-between border-b bg-muted/45 px-4 py-2.5">
        <span className="text-xs font-bold">#{request.protocol}</span>
        {request.priority === "urgent" && <Badge className="bg-brand-orange-soft text-brand-orange">Prioridade alta</Badge>}
      </div>
      <div className="p-4">
        <div className="flex gap-3">
          <div className="flex size-11 shrink-0 items-center justify-center rounded-md bg-brand-orange-soft text-brand-orange">
            <Icon className="size-5" />
          </div>
          <div className="min-w-0 flex-1">
            <p className="text-xs text-muted-foreground">{request.device_type} • {request.brand}</p>
            <h2 className="truncate text-base font-bold">{request.model}</h2>
            <p className="mt-1 line-clamp-2 text-sm">{request.issue_title}</p>
          </div>
        </div>

        <div className="mt-4 grid grid-cols-2 gap-3 border-y py-3 text-xs">
          <Info icon={MapPin} label={`${request.neighborhood} • ${request.distance_km.toFixed(1)} km`} />
          <Info icon={request.service_mode === "Coleta" ? Truck : UserRound} label={request.service_mode} />
          <Info icon={CalendarDays} label={request.preferred_window} />
          <Info icon={Clock3} label={`Prazo: ${request.estimated_days}`} />
        </div>

        <div className="mt-4 flex items-end justify-between gap-3">
          <div>
            <p className="text-[11px] font-semibold uppercase text-muted-foreground">Estimativa prévia</p>
            <p className="mt-0.5 font-bold text-brand-orange">
              {money(request.estimated_min_cents)} – {money(request.estimated_max_cents)}
            </p>
          </div>
          <Button variant="navy" onClick={onOpen}>Ver chamado <ChevronRight /></Button>
        </div>
      </div>
    </article>
  );
}

function Info({ icon: Icon, label }: { icon: typeof MapPin; label: string }) {
  return <span className="flex items-center gap-1.5 text-muted-foreground"><Icon className="size-3.5 text-brand-orange" />{label}</span>;
}

function RequestDetails({ request, onClose, onDecide }: {
  request: ServiceRequest | null;
  onClose: () => void;
  onDecide: (value: "accepted" | "declined") => void;
}) {
  return (
    <Dialog open={Boolean(request)} onOpenChange={(open) => !open && onClose()}>
      <DialogContent className="max-h-[90vh] overflow-y-auto p-0 sm:max-w-2xl">
        {request && <>
          <div className="bg-brand-deep p-5">
            <DialogHeader>
              <DialogTitle>{request.brand} {request.model}</DialogTitle>
              <DialogDescription>{request.device_type} • {request.issue_title}</DialogDescription>
            </DialogHeader>
          </div>
          <div className="space-y-5 p-5">
            <div>
              <h3 className="text-xs font-bold uppercase text-muted-foreground">Problema relatado</h3>
              <p className="mt-2 text-sm leading-6">{request.issue_description}</p>
            </div>
            <div className="grid gap-3 sm:grid-cols-2">
              <Detail label="Cliente" value={request.customer_name} />
              <Detail label="Localização" value={`${request.neighborhood} • ${request.distance_km.toFixed(1)} km`} />
              <Detail label="Atendimento" value={request.service_mode} />
              <Detail label="Janela preferida" value={request.preferred_window} />
              <Detail label="Estimativa" value={`${money(request.estimated_min_cents)} – ${money(request.estimated_max_cents)}`} />
              <Detail label="Prazo" value={request.estimated_days} />
            </div>
          </div>
          <DialogFooter className="border-t p-4">
            <Button variant="outline" onClick={() => onDecide("declined")}>Recusar chamado</Button>
            <Button variant="brand" onClick={() => onDecide("accepted")}><PackageCheck /> Aceitar atendimento</Button>
          </DialogFooter>
        </>}
      </DialogContent>
    </Dialog>
  );
}

function Detail({ label, value }: { label: string; value: string }) {
  return <div className="rounded-md bg-muted p-3"><p className="text-[11px] uppercase text-muted-foreground">{label}</p><p className="mt-1 text-sm font-semibold">{value}</p></div>;
}

function DecisionDialog({ request, decision, saving, onCancel, onConfirm }: {
  request: ServiceRequest | null;
  decision: "accepted" | "declined" | null;
  saving: boolean;
  onCancel: () => void;
  onConfirm: () => void;
}) {
  const accepting = decision === "accepted";
  return (
    <Dialog open={Boolean(decision)} onOpenChange={(open) => !open && onCancel()}>
      <DialogContent className="sm:max-w-md">
        <DialogHeader>
          <DialogTitle>{accepting ? "Aceitar este atendimento?" : "Recusar este chamado?"}</DialogTitle>
          <DialogDescription>Chamado {request?.protocol ?? ""}</DialogDescription>
        </DialogHeader>
        <DialogFooter>
          <Button variant="outline" onClick={onCancel} disabled={saving}>Cancelar</Button>
          <Button variant={accepting ? "brand" : "destructive"} onClick={onConfirm} disabled={saving}>
            {saving ? "Salvando..." : "Confirmar"}
          </Button>
        </DialogFooter>
      </DialogContent>
    </Dialog>
  );
}

function deviceIcon(device: string) {
  if (device === "Notebook") return Laptop;
  if (device === "Tablet") return Tablet;
  if (device === "Videogame") return LayoutGrid;
  return Smartphone;
}

function money(cents: number) {
  return new Intl.NumberFormat("pt-BR", {
    style: "currency",
    currency: "BRL",
    maximumFractionDigits: 0,
  }).format(cents / 100);
}
