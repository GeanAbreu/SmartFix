import { queryOptions, useQueryClient, useSuspenseQuery } from "@tanstack/react-query";
import { createFileRoute } from "@tanstack/react-router";
import { useServerFn } from "@tanstack/react-start";
import {
  Bell, CalendarDays, ChevronRight, ClipboardList, Clock3, Laptop,
  LayoutGrid, MapPin, Menu, PackageCheck, Search, Smartphone,
  Tablet, TrendingUp, Truck, UserRound, WalletCards, X, Zap,
} from "lucide-react";
import { useEffect, useMemo, useState } from "react";
import { toast } from "sonner";

import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import {
  Dialog, DialogContent, DialogDescription, DialogFooter,
  DialogHeader, DialogTitle,
} from "@/components/ui/dialog";
import { Input } from "@/components/ui/input";
import {
  Select, SelectContent, SelectItem, SelectTrigger, SelectValue,
} from "@/components/ui/select";
import { Toaster } from "@/components/ui/sonner";
import { supabase } from "@/integrations/supabase/client";
import type { Tables } from "@/integrations/supabase/types";
import {
  listOpenServiceRequests,
  triageServiceRequest,
} from "@/lib/service-requests.functions";
import { cn } from "@/lib/utils";

type ServiceRequest = Tables<"service_requests">;
type SortOption = "recent" | "nearby" | "urgent";

const requestsQuery = queryOptions({
  queryKey: ["service-requests", "open", "florianopolis", 10],
  queryFn: () => listOpenServiceRequests(),
});

export const Route = createFileRoute("/")({
  head: () => ({
    meta: [
      { title: "Novos chamados | SmartFix Parceiros" },
      {
        name: "description",
        content: "Painel técnico SmartFix para visualizar e atender novos chamados na região.",
      },
      { property: "og:title", content: "Painel técnico SmartFix" },
      {
        property: "og:description",
        content: "Fila regional de novos chamados para assistências técnicas parceiras.",
      },
      { property: "og:type", content: "website" },
      { name: "twitter:card", content: "summary_large_image" },
    ],
  }),
  loader: ({ context }) => context.queryClient.ensureQueryData(requestsQuery),
  component: TechnicalDashboard,
});

const navItems = [
  { label: "Visão geral", icon: TrendingUp },
  { label: "Novos chamados", icon: ClipboardList, active: true },
  { label: "Em atendimento", icon: PackageCheck },
  { label: "Agenda", icon: CalendarDays },
  { label: "Financeiro", icon: WalletCards },
];

function TechnicalDashboard() {
  const { data: requests } = useSuspenseQuery(requestsQuery);
  const queryClient = useQueryClient();
  const triage = useServerFn(triageServiceRequest);
  const [query, setQuery] = useState("");
  const [device, setDevice] = useState("all");
  const [distance, setDistance] = useState("10");
  const [sort, setSort] = useState<SortOption>("recent");
  const [selected, setSelected] = useState<ServiceRequest | null>(null);
  const [decision, setDecision] = useState<"accepted" | "declined" | null>(null);
  const [saving, setSaving] = useState(false);

  useEffect(() => {
    const channel = supabase
      .channel("open-service-requests")
      .on(
        "postgres_changes",
        { event: "*", schema: "public", table: "service_requests" },
        () => void queryClient.invalidateQueries({ queryKey: requestsQuery.queryKey }),
      )
      .subscribe();

    return () => { void supabase.removeChannel(channel); };
  }, [queryClient]);

  const filtered = useMemo(() => {
    const search = query.trim().toLowerCase();
    return requests
      .filter((request) => {
        const text = `${request.protocol} ${request.brand} ${request.model} ${request.issue_title}`.toLowerCase();
        return (!search || text.includes(search)) &&
          (device === "all" || request.device_type === device) &&
          request.distance_km <= Number(distance);
      })
      .sort((a, b) => {
        if (sort === "nearby") return a.distance_km - b.distance_km;
        if (sort === "urgent") {
          return Number(b.priority === "urgent") - Number(a.priority === "urgent");
        }
        return new Date(b.created_at).getTime() - new Date(a.created_at).getTime();
      });
  }, [requests, query, device, distance, sort]);

  const urgent = requests.filter((item) => item.priority === "urgent").length;
  const average = requests.length
    ? requests.reduce((total, item) => total + item.distance_km, 0) / requests.length
    : 0;

  async function confirmDecision() {
    if (!selected || !decision) return;
    setSaving(true);
    try {
      await triage({ data: { requestId: selected.id, decision } });
      await queryClient.invalidateQueries({ queryKey: requestsQuery.queryKey });
      toast.success(decision === "accepted" ? "Chamado aceito com sucesso" : "Chamado recusado");
      setSelected(null);
      setDecision(null);
    } catch (error) {
      toast.error(error instanceof Error ? error.message : "Não foi possível concluir a ação.");
    } finally {
      setSaving(false);
    }
  }

  return (
    <div className="min-h-screen bg-background text-foreground">
      <Toaster richColors position="top-right" />
      <Header count={requests.length} />

      <div className="mx-auto flex max-w-[1600px]">
        <Sidebar />
        <main className="min-w-0 flex-1 px-4 pb-24 pt-6 sm:px-6 lg:px-10 lg:pb-10 lg:pt-8">
          <div className="mb-7 flex flex-col justify-between gap-4 md:flex-row md:items-end">
            <div>
              <p className="mb-2 flex items-center gap-2 text-xs font-bold uppercase text-brand-orange">
                <span className="size-2 rounded-full bg-brand-orange" />
                Oficina SmartFix Centro
              </p>
              <h1 className="text-2xl font-bold sm:text-3xl">Novos chamados</h1>
              <p className="mt-2 text-sm text-muted-foreground">
                Solicitações disponíveis em um raio de 10 km da sua oficina.
              </p>
            </div>
            <div className="flex items-center gap-2 rounded-md border bg-card px-3 py-2 text-xs text-muted-foreground">
              <span className="size-2 rounded-full bg-success" />
              Atualização em tempo real
            </div>
          </div>

          <section className="mb-7 grid grid-cols-2 gap-3 xl:grid-cols-4">
            <Metric icon={ClipboardList} label="Novos chamados" value={String(requests.length)} note="na sua região" />
            <Metric icon={Zap} label="Prioridade alta" value={String(urgent)} note="resposta rápida" accent />
            <Metric icon={MapPin} label="Distância média" value={`${average.toFixed(1)} km`} note="da oficina" />
            <Metric icon={TrendingUp} label="Taxa de aceite" value="86%" note="últimos 30 dias" />
          </section>

          <section className="rounded-md border bg-card p-4">
            <div className="grid gap-3 md:grid-cols-[minmax(220px,1fr)_160px_150px_175px]">
              <div className="relative">
                <Search className="absolute left-3 top-1/2 size-4 -translate-y-1/2 text-muted-foreground" />
                <Input
                  aria-label="Buscar chamados"
                  value={query}
                  onChange={(event) => setQuery(event.target.value)}
                  placeholder="Buscar por aparelho, defeito ou protocolo"
                  className="h-10 pl-9"
                />
              </div>

              <Select value={device} onValueChange={setDevice}>
                <SelectTrigger><SelectValue /></SelectTrigger>
                <SelectContent>
                  <SelectItem value="all">Todos os aparelhos</SelectItem>
                  <SelectItem value="Smartphone">Smartphones</SelectItem>
                  <SelectItem value="Notebook">Notebooks</SelectItem>
                  <SelectItem value="Tablet">Tablets</SelectItem>
                  <SelectItem value="Videogame">Videogames</SelectItem>
                </SelectContent>
              </Select>

              <Select value={distance} onValueChange={setDistance}>
                <SelectTrigger><SelectValue /></SelectTrigger>
                <SelectContent>
                  <SelectItem value="5">Até 5 km</SelectItem>
                  <SelectItem value="8">Até 8 km</SelectItem>
                  <SelectItem value="10">Até 10 km</SelectItem>
                </SelectContent>
              </Select>

              <Select value={sort} onValueChange={(value) => setSort(value as SortOption)}>
                <SelectTrigger><SelectValue /></SelectTrigger>
                <SelectContent>
                  <SelectItem value="recent">Mais recentes</SelectItem>
                  <SelectItem value="nearby">Mais próximos</SelectItem>
                  <SelectItem value="urgent">Prioridade primeiro</SelectItem>
                </SelectContent>
              </Select>
            </div>
          </section>

          <div className="mt-5 flex items-center justify-between">
            <p className="text-sm font-semibold">{filtered.length} chamados encontrados</p>
            {(query || device !== "all" || distance !== "10") && (
              <Button variant="ghost" size="sm" onClick={() => {
                setQuery(""); setDevice("all"); setDistance("10");
              }}>
                <X /> Limpar filtros
              </Button>
            )}
          </div>

          <section className="mt-3 grid gap-3 2xl:grid-cols-2">
            {filtered.map((request) => (
              <RequestCard key={request.id} request={request} onOpen={() => setSelected(request)} />
            ))}
          </section>

          {filtered.length === 0 && (
            <section className="mt-12 py-12 text-center">
              <Search className="mx-auto size-9 text-muted-foreground" />
              <h2 className="mt-4 text-lg font-bold">Nenhum chamado encontrado</h2>
            </section>
          )}
        </main>
      </div>

      <RequestDetails request={selected} onClose={() => setSelected(null)} onDecide={setDecision} />
      <DecisionDialog
        request={selected}
        decision={decision}
        saving={saving}
        onCancel={() => setDecision(null)}
        onConfirm={confirmDecision}
      />
    </div>
  );
}

