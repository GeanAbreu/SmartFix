import { createClient } from "@supabase/supabase-js";
import { createServerFn } from "@tanstack/react-start";
import { z } from "zod";
import type { Database } from "@/integrations/supabase/types";

function createPublicClient() {
  const url = process.env["SUPABASE_URL"]!;
  const key = process.env["SUPABASE_PUBLISHABLE_KEY"]!;

  return createClient<Database>(url, key, {
    auth: { persistSession: false, autoRefreshToken: false },
  });
}

export const listOpenServiceRequests = createServerFn({ method: "GET" }).handler(async () => {
  const { data, error } = await createPublicClient()
    .from("service_requests")
    .select("*")
    .eq("status", "open")
    .lte("distance_km", 10)
    .order("created_at", { ascending: false });

  if (error) throw new Error("Não foi possível carregar os chamados.");
  return data;
});

export const triageServiceRequest = createServerFn({ method: "POST" })
  .inputValidator((input) => z.object({
    requestId: z.string().uuid(),
    decision: z.enum(["accepted", "declined"]),
  }).parse(input))
  .handler(async ({ data }) => {
    const { supabaseAdmin } = await import("@/integrations/supabase/client.server");
    const { data: updated, error } = await supabaseAdmin
      .from("service_requests")
      .update({ status: data.decision, responded_at: new Date().toISOString() })
      .eq("id", data.requestId)
      .eq("status", "open")
      .select("id")
      .maybeSingle();

    if (error || !updated) throw new Error("Este chamado não está mais disponível.");
    return { ok: true };
  });
CREATE TYPE public.service_request_status AS ENUM ('open', 'accepted', 'declined');

CREATE TABLE public.service_requests (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  protocol TEXT NOT NULL UNIQUE,
  customer_name TEXT NOT NULL,
  customer_initials TEXT NOT NULL,
  device_type TEXT NOT NULL,
  brand TEXT NOT NULL,
  model TEXT NOT NULL,
  issue_title TEXT NOT NULL,
  issue_description TEXT NOT NULL,
  neighborhood TEXT NOT NULL,
  city TEXT NOT NULL,
  distance_km NUMERIC(5,1) NOT NULL CHECK (distance_km >= 0),
  service_mode TEXT NOT NULL CHECK (service_mode IN ('Coleta', 'Presencial')),
  preferred_window TEXT NOT NULL,
  estimated_min_cents INTEGER NOT NULL CHECK (estimated_min_cents >= 0),
  estimated_max_cents INTEGER NOT NULL CHECK (estimated_max_cents >= estimated_min_cents),
  estimated_days TEXT NOT NULL,
  priority TEXT NOT NULL DEFAULT 'normal' CHECK (priority IN ('normal', 'urgent')),
  status public.service_request_status NOT NULL DEFAULT 'open',
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  responded_at TIMESTAMPTZ
);

GRANT SELECT ON public.service_requests TO anon;
GRANT SELECT, INSERT, UPDATE, DELETE ON public.service_requests TO authenticated;
GRANT ALL ON public.service_requests TO service_role;

ALTER TABLE public.service_requests ENABLE ROW LEVEL SECURITY;

CREATE POLICY "Public can view open requests"
ON public.service_requests FOR SELECT TO anon
USING (status = 'open');

CREATE POLICY "Partners can view requests"
ON public.service_requests FOR SELECT TO authenticated
USING (true);

CREATE POLICY "Partners can triage requests"
ON public.service_requests FOR UPDATE TO authenticated
USING (status = 'open')
WITH CHECK (status IN ('accepted', 'declined'));

CREATE INDEX service_requests_open_distance_idx
ON public.service_requests (status, distance_km, created_at DESC);

ALTER PUBLICATION supabase_realtime ADD TABLE public.service_requests;
