# PostgreSQL / Supabase Postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Supabase e outros bancos gerenciados normalmente exigem SSL.
# Para PostgreSQL local, use false.
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_LOGGING=false
DB_POOL_MAX=5

# Gere uma string aleatória com pelo menos 32 caracteres.
# Exemplo no terminal: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=troque-por-uma-chave-longa-e-aleatoria-com-mais-de-32-caracteres

# Origem da aplicação. HTTPS obrigatório em produção.
APP_URL=http://localhost:3000

# IDs de contas já cadastradas, separados por vírgula. Vazio = nenhum admin.
ADMIN_USER_IDS=

# Opcionais: envio de e-mail (remetente validado no Resend).
RESEND_API_KEY=
MAIL_FROM=

# Opcionais: OAuth Google. Callback: APP_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcional, somente development: pasta isolada para dados locais.
# SMARTFIX_LOCAL_DATA_DIR=
